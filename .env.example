# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=illumio_workloads
DB_USER=
DB_PASSWORD=

# Illumio PCE connection
# Set ILLUMIO_USE_REAL_CLIENT=true to connect to a real PCE
# Leave as false to use mock data
ILLUMIO_USE_REAL_CLIENT=false
# Keep false for read-only PCE access. Set true only when you deliberately
# authorize approved label changes to be written to PCE.
ILLUMIO_ALLOW_PCE_WRITEBACK=false

ILLUMIO_PCE_HOST=my-pce.illumio.com
ILLUMIO_PCE_PORT=8443
ILLUMIO_ORG_ID=1
ILLUMIO_API_KEY_ID=api_xxxxxxxxxxxxxxxx
ILLUMIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to false only for self-signed TLS certificates (dev/lab PCEs)
ILLUMIO_TLS_VERIFY=true

# Web deployment security. Keep local for development. A public deployment
# requires a Cloudflare Access application and exact values from its dashboard.
WEB_DEPLOYMENT_MODE=local
WEB_CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
WEB_CLOUDFLARE_ACCESS_AUD=
# Comma-separated list of Cloudflare Access emails permitted in the pilot.
# If unset, all authenticated Cloudflare Access users are permitted.
WEB_PILOT_ALLOWED_EMAILS=
